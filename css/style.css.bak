:repeat(4,1fr)}.stats-grid>div{min-height:85px;display:flex;align-items:center;gap:15px;padding:16px 22px;border-right:1px solid #ffffff15}.stats-grid>div:last-child{border:0}.stats-grid strong{font:700 28px Oswald;color:#fff}.stats-grid span{font-size:9px;font-weight:900;letter-spacing:1px;line-height:1.35;color:#ddd}.section{padding:90px 0}.about-grid{display:grid;grid-template-columns:38% 62%;gap:34px;align-items:center}.about-copy .tag,.work-copy .tag,.impact-copy .tag{color:var(--red)}.about-copy h2,.work-copy h2,.impact-copy h2{font:700 56px/.93 Oswald,Impact,sans-serif;margin:14px 0 25px}.about-copy p,.work-copy p,.impact-copy p{max-width:500px;font-size:12px;line-height:1.75;color:#565b60}.small-btn,.outline-btn{display:inline-flex;align-items:center;gap:18px;margin-top:23px;padding:12px 18px;background:var(--red);color:#fff;font-size:10px;font-weight:900}.outline-btn{background:transparent;color:#111;border:1px solid #111}.about-scene{height:500px;position:relative}.about-frame{position:absolute;overflow:hidden}.about-frame img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,0,1)}.about-frame:hover img{transform:scale(1.08)}.about-frame.f1{left:0;top:0;width:57%;height:57%}.about-frame.f2{right:0;top:0;width:40%;height:46%}.about-frame.f3{right:0;bottom:0;width:50%;height:48%}.year-badge{position:absolute;left:0;bottom:0;width:46%;height:38%;background:var(--red);color:#fff;padding:26px;display:flex;flex-direction:column;justify-content:center}.year-badge strong{font:700 65px Oswald;line-height:.8}.year-badge span{font:700 19px/1.05 Oswald;margin-top:14px}.scan-line{position:absolute;left:-5%;width:110%;height:1px;background:#fff6;top:50%;animation:scan 4s ease-in-out infinite}.solutions-360{background:var(--soft);overflow:hidden}.section-head{text-align:center;margin-bottom:48px}.section-head h2{font:700 48px/1 Oswald;margin:9px 0}.section-head>p{font-size:11px;color:#676767}.orbit-layout{display:grid;grid-template-columns:56% 44%;align-items:center}.orbit-ring{width:min(560px,100%);aspect-ratio:1;position:relative;border:1px solid #d9d9d9;border-radius:50%;margin:auto}.orbit-ring:before,.orbit-ring:after{content:'';position:absolute;inset:8%;border:1px dashed #d1d1d1;border-radius:50%}.orbit-ring:after{inset:27%;border:1px solid #e2e2e2}.orbit-glow{position:absolute;inset:36%;border-radius:50%;background:radial-gradient(circle,#e51b231e,transparent 68%);filter:blur(10px)}.orbit-center{position:absolute;inset:38%;border-radius:50%;background:#121416;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 20px 60px #0002}.orbit-center span{font:700 46px Oswald;color:#fff}.orbit-center small{font-weight:900;letter-spacing:3px;color:#bbb}.orbit-card{position:absolute;width:105px;height:105px;border-radius:50%;border:1px solid #d7d7d7;background:#fff;box-shadow:0 15px 35px #0000000d;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;transition:.4s}.orbit-card b{font:700 12px Inter;color:var(--red);margin-bottom:4px}.orbit-card span{font-size:11px;font-weight:800}.orbit-card:hover,.orbit-card.active{background:var(--red);color:#fff;transform:scale(1.12);box-shadow:0 18px 45px #e51b2334}.orbit-card.active b{color:#fff}.oc1{top:-9px;left:50%;margin-left:-52px}.oc2{top:17%;right:0}.oc3{bottom:18%;right:2%}.oc4{bottom:-8px;left:50%;margin-left:-52px}.oc5{bottom:18%;left:2%}.oc6{top:17%;left:0}.service-panel{padding-left:45px;max-width:450px}.service-count{font:700 13px Oswald;color:#8a8d90;margin-bottom:24px}.service-panel .tag{color:var(--red)}.service-panel h3{font:700 46px/1 Oswald;margin:12px 0 20px}.service-panel p{font-size:13px;line-height:1.75;color:#64696d;min-height:74px}.service-meter{height:3px;background:#ddd;margin:28px 0 20px}.service-meter span{display:block;height:100%;background:var(--red);width:16.666%;transition:width .6s}.service-next{background:none;border:0;padding:0;font-size:10px;f