/* =========================================================
   EXPERIENCE / INDUSTRIAL PRESENCE
   ========================================================= */
.experience{background:#fff;position:relative;overflow:hidden;padding-top:95px;padding-bottom:95px}
.experience-grid{display:grid;grid-template-columns:49% 51%;align-items:center;gap:35px}
.experience-art{position:relative;min-height:430px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.experience-art img{width:92%;height:auto;max-height:430px;object-fit:contain;mix-blend-mode:multiply;position:relative;z-index:2;filter:contrast(1.02)}
.experience-art-glow{position:absolute;width:310px;height:310px;border-radius:50%;border:1px solid #e51b2330;box-shadow:0 0 0 24px #e51b2308,0 0 80px #e51b2314;animation:experiencePulse 4s ease-in-out infinite}
.experience-dot{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--red);z-index:3;box-shadow:0 0 18px #e51b2370}
.experience-dot.d1{top:18%;left:19%;animation:floatDot 4s ease-in-out infinite}
.experience-dot.d2{top:34%;right:13%;animation:floatDot 5s ease-in-out .7s infinite}
.experience-dot.d3{bottom:18%;left:30%;animation:floatDot 4.7s ease-in-out 1.1s infinite}
.experience-copy{padding-left:25px}
.since{display:inline-flex;align-items:center;gap:9px;font-weight:900;font-size:16px;letter-spacing:.7px;margin-bottom:22px}
.since strong{display:inline-flex;padding:5px 9px;background:#111;color:#fff;font-size:17px}
.experience-copy h2{font:700 clamp(40px,4.4vw,61px)/1.05 Oswald,Impact,sans-serif;text-transform:none;margin:0 0 25px;letter-spacing:-.6px}
.experience-copy>p{max-width:650px;color:#666;font-size:13px;line-height:1.8;margin:0 0 18px}
.experience-copy .experience-quote{font-style:italic;color:#171717;line-height:2.02;font-size:13px}
.experience-link{display:inline-flex;align-items:center;gap:18px;margin-top:8px;padding:12px 0;font-size:11px;font-weight:900;letter-spacing:.8px;color:#111;border-bottom:2px solid var(--red)}
.experience-link span{color:var(--red);transition:transform .25s}
.experience-link:hover span{transform:translateX(6px)}
@keyframes experiencePulse{0%,100%{transform:scale(.97);opacity:.55}50%{transform:scale(1.04);opacity:.95}}
@keyframes floatDot{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

@media(max-width:1050px){.experience-grid{grid-template-columns:1fr}.experience-copy{padding-left:0}.experience-art{min-height:360px;order:0}.experience-copy{order:1}}
@media(max-width:760px){.experience{padding:65px 0}.experience-art{min-height:290px}.experience-art img{width:100%;max-height:300px}.experience-art-glow{width:220px;height:220px}.experience-copy h2{font-size:45px}.experience-copy>p{font-size:12px}.experience-copy .experience-quote{line-height:1.8;font-size:12px}.since{font-size:14px}.since strong{font-size:15px}}

/* ===== FINAL POLISH: CLIENTS / SOLUTIONS / CHATBOT / FOOTER ===== */
.client-feature{display:flex;align-items:center;gap:14px;margin-top:25px;max-width:400px;padding:10px;border:1px solid #ffffff16;background:#ffffff06;backdrop-filter:blur(8px)}
.client-feature img{width:108px;height:58px;object-fit:cover;flex:0 0 auto}
.client-feature div{display:flex;flex-direction:column;gap:5px}.client-feature b{font-size:9px;letter-spacing:1.2px}.client-feature span{font-size:10px;color:#9fa5aa}
.client-pulse{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--red);left:50%;top:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 0 #e51b2350;animation:clientPulse 2.2s infinite;z-index:1}
@keyframes clientPulse{0%{box-shadow:0 0 0 0 #e51b2350}70%{box-shadow:0 0 0 35px #e51b2300}100%{box-shadow:0 0 0 0 #e51b2300}}

.solution-showcase{transition:background .9s ease}.solution-showcase.theme-digital .showcase-bg{background:radial-gradient(circle at 74% 50%,#e51b2360,transparent 28%),linear-gradient(120deg,#180d0f,#0f1418)!important}
.solution-showcase.theme-static .showcase-bg{background:radial-gradient(circle at 74% 50%,#c8cbd133,transparent 28%),linear-gradient(120deg,#282a2d,#101214)!important}
.solution-showcase.theme-transit .showcase-bg{background:radial-gradient(circle at 74% 50%,#2895d050,transparent 30%),linear-gradient(120deg,#09202c,#101416)!important}
.solution-showcase.theme-digital .big-word span{color:#ff2832}.solution-showcase.theme-static .big-word span{color:#fff}.solution-showcase.theme-transit .big-word span{color:#53bffb}
.solution-showcase.theme-static .word-ring{border-color:#ffffff2b}.solution-showcase.theme-transit .word-ring{border-color:#53bffb35}
.tab.active{box-shadow:0 10px 35px #0003}.tab:hover{color:#fff;transform:translateX(5px)}

/* chatbot */
.chatbot{position:fixed;right:24px;bottom:24px;z-index:180;border:0;background:transparent;color:#fff;display:flex;align-items:center;gap:9px;cursor:pointer;padding:0;filter:drop-shadow(0 15px 30px #0003)}
.chatbot-orb{width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#ef1e27,#a80f15);border:2px solid #fff;display:grid;place-items:center;font-size:23px;box-shadow:0 0 0 7px #e51b2324;animation:botFloat 3.2s ease-in-out infinite}
.chatbot-text{display:flex;flex-direction:column;align-items:flex-start;background:#101316;padding:9px 13px;border:1px solid #ffffff18;border-radius:8px;opacity:0;transform:translateX(8px);transition:.3s;pointer-events:none}.chatbot:hover .chatbot-text{opacity:1;transform:none}
.chatbot-text b{font-size:10px}.chatbot-text small{font-size:8px;color:#54d975;margin-top:2px}
@keyframes botFloat{50%{transform:translateY(-5px)}100%{transform:none}}
.chat-panel{position:fixed;right:24px;bottom:92px;width:330px;z-index:185;background:#fff;border:1px solid #ddd;box-shadow:0 30px 80px #0003;transform:translateY(20px) scale(.96);opacity:0;pointer-events:none;transition:.3s;overflow:hidden}.chat-panel.open{transform:none;opacity:1;pointer-events:auto}
.chat-head{background:#111416;color:#fff;padding:15px 16px;display:flex;align-items:center;justify-content:space-between}.chat-head>div{display:flex;flex-direction:column}.chat-head b{font-size:13px}.chat-head small{font-size:9px;color:#9da2a6;margin-top:4px}.chat-head button{border:0;background:transparent;color:#fff;font-size:24px;cursor:pointer}
.chat-body{padding:16px}.chat-intro{margin:0;font-size:11px;color:#555;line-height:1.6}.chat-options{display:grid;gap:8px;margin-top:13px}.chat-options button{background:#f7f7f7;border:1px solid #e8e8e8;text-align:left;padding:11px 12px;font-size:10px;font-weight:800;cursor:pointer;transition:.2s}.chat-options button:hover{border-color:var(--red);background:#fff1f1;transform:translateX(4px)}.chat-reply{margin-top:12px;font-size:10px;color:#555;line-height:1.55;min-height:22px}
.footer .site-logo img{width:165px;max-height:50px}.footer-top{min-height:96px}.footer-bottom>.container{font-size:10px}.footer-mid{box-shadow:0 -6px 20px #00000004}
@media(max-width:760px){.client-feature{max-width:100%}.chatbot{right:15px;bottom:15px}.chat-panel{right:15px;bottom:83px;width:min(330px,calc(100% - 30px))}.chatbot-text{display:none}.footer .site-logo img{width:155px}}

/* ===== 360° Client Carousel (matches reference) ===== */
.clients-wrap{grid-template-columns:30% 70%;gap:24px}
.client-nav{display:flex;align-items:center;gap:16px;margin-top:34px}
.client-arrow{width:38px;height:38px;border-radius:50%;border:1px solid #ffffff35;background:transparent;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;transition:.25s}
.client-arrow:hover{background:#fff;color:#111;border-color:#fff}
.client-dots{display:flex;align-items:center;gap:8px}
.client-dots .dot{width:8px;height:8px;border-radius:50%;background:#ffffff30;transition:.25s}
.client-dots .dot.active{background:var(--red);width:22px;border-radius:5px}
.client-stats{display:flex;gap:26px;margin-top:34px;padding-top:22px;border-top:1px solid #ffffff1e;flex-wrap:wrap}
.client-stats div{display:flex;flex-direction:column;gap:2px}
.client-stats strong{font:700 22px Oswald;color:var(--red)}
.client-stats span{font-size:10px;color:#bbb;font-weight:700;letter-spacing:.4px}
.client-stage{position:relative;height:380px;display:flex;align-items:center;justify-content:center;perspective:1700px;overflow:hidden}
.client-stage:before{content:'';position:absolute;inset:-10% 6%;background:radial-gradient(ellipse at center,#e51b2336,transparent 62%);filter:blur(18px);z-index:0}
.client-arc{position:absolute;bottom:2%;left:6%;width:88%;height:34%;border:1px solid #e51b2320;border-radius:50%;pointer-events:none}
.client-carousel{position:relative;width:100%;height:280px;transform-style:preserve-3d;z-index:1}
.client-card3d{position:absolute;top:50%;left:50%;width:152px;height:212px;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:center;padding:18px;box-shadow:0 22px 45px #00000070,0 0 0 1px #0000000f;transition:transform .8s cubic-bezier(.22,.8,.2,1),opacity .8s,filter .8s}
.client-card3d img{max-width:78%;max-height:58%;object-fit:contain}
.client-card3d.center{box-shadow:0 28px 65px #e51b2360,0 0 0 1px #ffffff25}
.client-reflection{position:absolute;bottom:-4%;left:10%;width:80%;height:52px;background:radial-gradient(ellipse at center,#e51b232e,transparent 72%);filter:blur(6px);pointer-events:none;z-index:0}
.client-360{position:absolute;bottom:-2%;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;width:58px;height:58px;border-radius:50%;border:1px solid #ffffff30;color:#fff;font:700 10px Oswald;letter-spacing:.5px;background:#0b0d10cc;z-index:2}
.client-360 svg{width:20px;height:11px}
.client-360 .ring{position:absolute;inset:-12px;border:1px dashed #ffffff20;border-radius:50%;animation:spin 20s linear infinite}
@media(max-width:1050px){.clients-wrap{grid-template-columns:1fr}.client-stage{margin-top:40px}}
@media(max-width:760px){.client-stage{height:260px}.client-card3d{width:96px;height:134px;padding:12px;border-radius:14px}.client-stats{gap:18px}.client-360{width:46px;height:46px}}


/* ===== FINAL FUNCTIONAL FIX: CLIENTS + SOLUTIONS + WORK/NETWORK ===== */
.hero-inner{justify-content:center;align-items:flex-start}
.hero-inner h1{font-size:clamp(44px,6vw,82px);line-height:.94;max-width:760px;margin:0;letter-spacing:-1.5px;text-shadow:0 8px 35px #0009}
.hero-inner h1 em{font-style:normal;color:#fff}

/* Clients: never depend on reveal animation for the carousel itself */
.clients{min-height:520px}
.clients-wrap{display:grid!important;grid-template-columns:minmax(330px,31%) minmax(0,69%)!important;gap:28px!important;align-items:center!important}
.clients-copy{position:relative;z-index:5}
.client-stage{position:relative!important;display:block!important;height:410px!important;min-width:0;overflow:visible!important;perspective:1800px;isolation:isolate}
.client-stage:before{content:'';position:absolute;inset:4% 3% 12%;background:radial-gradient(ellipse at center,#e51b2348 0%,#e51b2318 28%,transparent 66%);filter:blur(22px);z-index:0;pointer-events:none}
.client-carousel{position:absolute!important;inset:0!important;width:100%!important;height:330px!important;transform-style:preserve-3d!important;z-index:3!important}
.client-card3d{appearance:none;border:0;cursor:pointer;position:absolute!important;top:47%!important;left:50%!important;width:165px!important;height:225px!important;border-radius:12px!important;background:linear-gradient(145deg,#fff,#f4f4f4)!important;padding:20px!important;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden;box-shadow:0 28px 55px #0008,0 0 0 1px #ffffffaa!important;backface-visibility:hidden;will-change:transform,opacity;transition:transform .72s cubic-bezier(.22,.75,.18,1),opacity .72s,filter .72s!important}
.client-card3d:after{content:'';position:absolute;inset:0;background:linear-gradient(120deg,#fff8,transparent 40%,#00000005);pointer-events:none}
.client-card3d img{display:block!important;width:100%!important;height:100%!important;max-width:100%!important;max-height:100%!important;object-fit:contain!important;position:relative;z-index:1}
.client-card3d.center{box-shadow:0 35px 75px #e51b2360,0 0 35px #e51b2330,0 0 0 1px #fff!important}
.client-arc{position:absolute!important;bottom:11%!important;left:3%!important;width:94%!important;height:31%!important;border:1px solid #e51b2360!important;border-radius:50%!important;box-shadow:0 0 35px #e51b231c!important;z-index:1}
.client-reflection{position:absolute!important;bottom:5%!important;left:10%!important;width:80%!important;height:70px!important;background:radial-gradient(ellipse,#e51b2340,transparent 70%)!important;filter:blur(8px)!important;z-index:0!important}
.client-360{bottom:1%!important;width:58px!important;height:58px!important;border-radius:50%!important;z-index:6!important}
.client-nav{position:relative;z-index:10}
.client-dots .dot{border:0;padding:0;cursor:pointer}
.client-dots .dot.active{width:22px!important;background:var(--red)!important}

/* Solutions showcase: visible media instead of an empty text-only stage */
.solution-showcase{min-height:560px!important;position:relative;overflow:hidden}
.showcase-grid{min-height:560px!important;align-items:center!important}
.showcase-visual{position:relative!important;height:430px!important;min-width:0;display:flex!important;align-items:center!important;justify-content:center!important;overflow:hidden!important;border-radius:20px}
.showcase-media{position:absolute!important;inset:8% 5%!important;border-radius:18px!important;overflow:hidden!important;opacity:0!important;transform:scale(.94) translateY(12px)!important;transition:opacity .65s ease,transform .65s ease!important;box-shadow:0 30px 70px #0009!important;border:1px solid #ffffff20!important;z-index:3!important}
.showcase-media.active{opacity:1!important;transform:scale(1) translateY(0)!important}
.showcase-media img{width:100%!important;height:100%!important;object-fit:cover!important;display:block!important;filter:saturate(.92) contrast(1.05) brightness(.72)!important}
.showcase-media:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#0008,transparent 55%,#0003),linear-gradient(0deg,#0008,transparent 55%);pointer-events:none}
.showcase-media span{position:absolute;left:28px;bottom:24px;z-index:2;font:700 clamp(34px,4vw,64px)/1 Oswald,Impact,sans-serif;letter-spacing:-1px;color:#fff;text-shadow:0 8px 25px #000}
.showcase-visual .word-ring,.showcase-visual .word-ring.small{z-index:1!important}
.showcase-index{z-index:5!important}

/* Work gallery */
.work-grid-cards{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:14px!important;height:auto!important}
.work-card{min-height:220px!important;position:relative!important;overflow:hidden!important;border-radius:10px!important;background:#111!important}
.work-card img{width:100%!important;height:100%!important;min-height:220px!important;object-fit:cover!important;display:block!important;transition:transform .6s ease!important}
.work-card:hover img{transform:scale(1.06)!important}
.work-card>div{position:absolute!important;left:0;right:0;bottom:0;padding:30px 14px 14px!important;background:linear-gradient(transparent,#000d)!important;color:#fff!important;display:flex!important;justify-content:space-between!important;align-items:flex-end!important}
.work-card>div small{font-size:9px!important;letter-spacing:1px!important}
.work-card>div b{font-size:18px!important}

/* Network image */
.network-photo{background-size:cover!important;background-position:center!important;filter:brightness(.48) saturate(.9)!important}
.network:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#050607e8 0%,#050607a8 46%,#05060735 100%);pointer-events:none}
.network-inner{z-index:3!important}

@media(max-width:1050px){
 .clients-wrap{grid-template-columns:1fr!important}
 .client-stage{height:390px!important;margin-top:25px}
 .showcase-grid{grid-template-columns:1fr!important}
 .showcase-visual{height:390px!important}
 .work-grid-cards{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}
@media(max-width:760px){
 .hero{height:560px!important}.hero-inner h1{font-size:43px!important}
 .clients{padding:55px 0!important}.client-stage{height:310px!important}.client-carousel{height:250px!important}
 .client-card3d{width:104px!important;height:145px!important;padding:12px!important;border-radius:10px!important}
 .client-arc{bottom:9%!important}.client-360{width:46px!important;height:46px!important;font-size:8px!important}
 .showcase-visual{height:300px!important}.showcase-media{inset:4% 0!important}.showcase-media span{font-size:32px!important;left:18px;bottom:18px}
 .work-grid-cards{grid-template-columns:1fr 1fr!important}.work-card{min-height:170px!important}.work-card img{min-height:170px!important}
}

/* Final client-requested layout: Solutions section is text-only; its three showcase images live in More Than Media. */
.solution-showcase .showcase-grid{grid-template-columns:minmax(0,1fr) !important;position:relative;min-height:560px !important;}
.solution-showcase .showcase-copy{max-width:720px;position:relative;z-index:4;padding:70px 0;}
.solution-showcase .showcase-text-stage{position:absolute;inset:0;pointer-events:none;overflow:hidden;display:block;}
.solution-showcase .showcase-text-stage .word-ring{position:absolute;right:9%;top:50%;transform:translateY(-50%);}
.solution-showcase .showcase-text-stage .word-ring.small{right:18%;}
.solution-showcase .showcase-text-stage .showcase-index{position:absolute;right:12%;bottom:70px;z-index:2;}
@media(max-width:1050px){.solution-showcase .showcase-copy{max-width:680px}.solution-showcase .showcase-text-stage .word-ring{right:0}.solution-showcase .showcase-text-stage .word-ring.small{right:10%;}}
@media(max-width:760px){.solution-showcase .showcase-grid{min-height:620px !important}.solution-showcase .showcase-copy{padding:50px 0}.solution-showcase .showcase-text-stage .word-ring{right:-70px;top:62%;}.solution-showcase .showcase-text-stage .word-ring.small{right:20px;top:62%;}.solution-showcase .showcase-text-stage .showcase-index{right:20px;bottom:35px;}}

/* ===== USER UPDATE: WORK VIDEO + AUTO-SCROLL GALLERY + RESPONSIVE CHATBOT ===== */
.work-gallery{min-width:0;display:grid;gap:14px;position:relative}
.work-video-card{grid-column:1/-1;height:250px;position:relative;overflow:hidden;border-radius:10px;background:#090a0c;border:1px solid #00000012;box-shadow:0 22px 55px #0002}
.work-video-card video{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.95) contrast(1.04) brightness(.78)}
.work-video-shade{position:absolute;inset:0;background:linear-gradient(90deg,#000b,transparent 55%,#0002),linear-gradient(0deg,#000b,transparent 55%);pointer-events:none}
.work-video-label{position:absolute;left:18px;right:18px;bottom:16px;display:flex;justify-content:space-between;align-items:center;color:#fff;z-index:2;font-size:9px;letter-spacing:1.1px;font-weight:800}
.work-video-label span{display:flex;align-items:center;gap:7px;font-size:8px;color:#eee}.work-video-label i{width:6px;height:6px;background:#e51b23;border-radius:50%;display:inline-block;box-shadow:0 0 0 5px #e51b2322}
.work-bottom-wrap{position:relative;min-width:0}.work-bottom-viewport{overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;scrollbar-width:none;scroll-snap-type:x mandatory;padding:1px}.work-bottom-viewport::-webkit-scrollbar{display:none}.work-bottom-track{display:flex;gap:14px;width:max-content}.work-bottom-track .work-card{width:calc((100% - 28px)/3);flex:0 0 calc((100vw - max(32px, (100vw - var(--max))/2)*2 - 28px)/3);max-width:360px;min-height:205px!important;scroll-snap-align:start}
.work-bottom-track .work-card img{min-height:205px!important;height:205px!important}.work-scroll-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:38px;height:38px;border-radius:50%;border:1px solid #ffffffcc;background:#0b0d10e8;color:#fff;display:grid;place-items:center;cursor:pointer;font-size:25px;line-height:1;box-shadow:0 10px 25px #0003;opacity:0;transition:.25s}.work-bottom-wrap:hover .work-scroll-arrow{opacity:1}.work-scroll-arrow.prev{left:8px}.work-scroll-arrow.next{right:8px}
.chatbot{position:fixed;right:24px;bottom:24px;z-index:180;border:1px solid #ffffff22;background:linear-gradient(135deg,#17191c,#0a0c0f);color:#fff;border-radius:18px;padding:10px 15px 10px 10px;display:flex;align-items:center;gap:10px;cursor:pointer;box-shadow:0 18px 45px #0005,0 0 0 1px #e51b2312;transition:transform .25s,box-shadow .25s}.chatbot:hover{transform:translateY(-4px);box-shadow:0 22px 50px #0006,0 0 28px #e51b2328}.chatbot-orb{width:38px;height:38px;border-radius:12px;background:linear-gradient(145deg,#e51b23,#8f0e14);display:grid;place-items:center;box-shadow:0 8px 20px #e51b2344}.chatbot-orb span{font-size:17px}.chatbot-text{display:flex;flex-direction:column;align-items:flex-start;gap:2px}.chatbot-text b{font-size:11px;letter-spacing:.3px}.chatbot-text small{font-size:8px;color:#bfc3c8;display:flex;align-items:center;gap:4px}.chatbot-text small i,.chat-brand small i{display:inline-block;width:6px;height:6px;border-radius:50%;background:#31d46c;box-shadow:0 0 0 4px #31d46c18}.chatbot-ping{position:absolute;left:43px;top:8px;width:7px;height:7px;border-radius:50%;background:#31d46c;animation:chatPing 1.8s infinite}.chat-panel{position:fixed;right:24px;bottom:92px;width:min(365px,calc(100vw - 32px));z-index:179;background:#0c0f12;color:#fff;border:1px solid #ffffff18;border-radius:20px;overflow:hidden;box-shadow:0 30px 80px #0008,0 0 40px #e51b2314;opacity:0;transform:translateY(14px) scale(.97);pointer-events:none;transition:.28s ease}.chat-panel.open{opacity:1;transform:none;pointer-events:auto}.chat-head{padding:15px 16px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#181b1f,#0b0d10);border-bottom:1px solid #ffffff12}.chat-brand{display:flex;align-items:center;gap:10px}.chat-brand-icon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:var(--red);font-size:14px}.chat-brand div{display:flex;flex-direction:column;gap:3px}.chat-head b{font-size:12px}.chat-head small{font-size:8px;color:#aeb4ba;display:flex;align-items:center;gap:5px}.chat-head button{border:0;background:#ffffff0b;color:#fff;width:30px;height:30px;border-radius:9px;cursor:pointer;font-size:19px}.chat-body{padding:16px}.chat-welcome{display:flex;gap:10px;align-items:flex-start;padding:12px;border:1px solid #ffffff10;border-radius:14px;background:#ffffff05}.chat-avatar{width:32px;height:32px;flex:0 0 32px;border-radius:10px;background:#fff;color:#111;display:grid;place-items:center;font-weight:900;font-size:12px}.chat-welcome b{font-size:11px}.chat-welcome p{margin:4px 0 0;font-size:10px;line-height:1.5;color:#bfc3c8}.chat-options{display:grid;gap:8px;margin-top:12px}.chat-options button{display:flex;align-items:center;gap:9px;text-align:left;width:100%;border:1px solid #ffffff12;background:#11151a;color:#fff;border-radius:11px;padding:11px 12px;font-size:10px;cursor:pointer;transition:.2s}.chat-options button:hover{border-color:#e51b2355;background:#e51b2312;transform:translateX(3px)}.chat-options button span{color:#e51b23;font:700 9px Oswald}.chat-options button b{margin-left:auto;color:#999}.chat-reply{display:none;margin-top:10px;padding:11px 12px;border-left:2px solid var(--red);background:#ffffff06;color:#dce0e4;font-size:10px;line-height:1.55;border-radius:0 9px 9px 0}.chat-reply:not(:empty){display:block}.chat-direct{display:flex;gap:8px;margin-top:12px}.chat-direct a{flex:1;text-align:center;padding:9px;border:1px solid #ffffff12;border-radius:9px;color:#ddd;font-size:9px;font-weight:800}.chat-direct a:hover{color:#fff;border-color:#e51b2355;background:#e51b2310}@keyframes chatPing{0%,100%{box-shadow:0 0 0 0 #31d46c33}50%{box-shadow:0 0 0 6px #31d46c00}}
@media(max-width:1050px){.work-grid{grid-template-columns:1fr!important}.work-video-card{height:330px}.work-bottom-track .work-card{flex-basis:calc((100vw - 64px - 28px)/3);max-width:none}}
