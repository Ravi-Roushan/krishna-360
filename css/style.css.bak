-radius:50%;border:1px solid #ffffff18;animation:spin 18s linear infinite}.word-ring.small{width:270px;height:270px;border-style:dashed;animation:spinReverse 11s linear infinite}.showcase-index{position:absolute;right:10px;bottom:15px;font:700 12px Oswald;color:#888}.work-grid{display:grid;grid-template-columns:28% 72%;gap:0;align-items:center}.work-copy{padding-right:35px}.work-grid-cards{display:grid;grid-template-columns:repeat(3,1fr);height:310px}.work-card{position:relative;overflow:hidden;background:#111}.work-card img{width:100%;height:100%;object-fit:cover;transition:transform .9s}.work-card:hover img{transform:scale(1.08)}.work-card>div{position:absolute;left:0;right:0;bottom:0;padding:16px;background:linear-gradient(transparent,#000c);display:flex;justify-content:space-between;align-items:end;color:#fff}.work-card>div small{font-size:9px;font-weight:900;letter-spacing:1px}.work-card>div b{font-size:16px}.work-card.idea{background:var(--red);padding:26px;color:#fff;display:flex;flex-direction:column;justify-content:space-between}.work-card.idea small{font-size:9px;letter-spacing:2px}.work-card.idea strong{font:700 42px/.9 Oswald}.work-card.idea span{font-size:20px}.impact{background:#f8f8f6}.impact-grid{display:grid;grid-template-columns:58% 42%;align-items:center}.impact-image{height:380px;overflow:hidden}.impact-image img{width:100%;height:100%;object-fit:cover;transition:transform .8s}.impact-image:hover img{transform:scale(1.05)}.impact-copy{padding-left:48px}.cta{background:linear-gradient(120deg,#e51b23,#c51218 60%,#a40f14);color:#fff;position:relative;overflow:hidden}.cta:after{content:'';position:absolute;right:-180px;top:-190px;width:600px;height:600px;border:90px solid #ffffff0a;border-radius:50%}.cta-inner{min-height:240px;display:flex;align-items:center;justify-content:space-between;gap:30px;position:relative;z-index:1}.cta-inner h2{font:700 47px/.93 Oswald;margin:12px 0}.cta-inner p{max-width:580px;font-size:11px;color:#ffecec}.footer-top{min-height:110px;display:grid;grid-template-columns:220px 1fr 350px;align-items:center;gap:25px}.footer-top nav{display:flex;justify-content:center;gap:20px;font-size:10px;font-weight:800}.legacy{text-align:right}.legacy small{display:block;color:#777;font-size:8px;margin-bottom:7px}.legacy img{width:200px;max-height:54px;object-fit:contain}.footer-mid{border-top:1px solid #eee;border-bottom:1px solid #eee;background:#fff}.contact-row{display:grid;grid-template-columns:1fr 1fr 1.6fr auto;align-items:center;gap:28px;padding:19px 0}.contact-row>div span{display:block;color:#999;font-size:8px;font-weight:900;letter-spacing:1.5px;margin-bottom:5px}.contact-row a,.contact-row p{font-size:11px;color:#333;margin:0}.footer-campaign{background:var(--red);color:#fff!important;padding:12px 17px;font-size:9px!important;font-weight:900;white-space:nowrap}.footer-bottom{background:#f6f7f7;border-top:1px solid #eee}.footer-bottom>.container{min-height:62px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:10px;color:#666}.social-text{display:flex;align-items:center;gap:7px}.social-text b{width:24px;height:24px;border-radius:50%;background:#111;color:#fff;display:grid;place-items:center;font-size:8px}.story-modal{display:none;position:fixed;inset:0;z-index:150;background:#000d;place-items:center;padding:25px}.story-modal.open{display:grid}.story-dialog{position:relative;width:min(1000px,95vw);background:#101214;color:#fff;box-shadow:0 30px 100px #000}.story-dialog>button{position:absolute;right:14px;top:8px;background:#fff;color:#111;border:0;width:36px;height:36px;border-radius:50%;font-size:25px;z-index:2;cursor:pointer}.story-dialog video{width:100%;display:block;max-height:65vh;object-fit:cover}.story-dialog>div:last-child{padding:22px 28px}.story-dialog h3{font:700 40px Oswald;line-height:.92;margin:10px 0}.cursor,.cursor-ring{position:fixed;pointer-events:none;z-index:300;border-radius:50%;transform:translate(-50%,-50%);opacity:0}.cursor{width:5px;height:5px;background:var(--red)}.cursor-ring{width:34px;height:34px;border:1px solid #fff;mix-blend-mode:difference;transition:transform .08s ease}.reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s cubic-bezier(.16,.7,0,1)}.reveal.in{opacity:1;transform:none}@keyframes scan{0%,100%{transform:translateY(-220px);opacity:0}20%,80%{opacity:1}50%{transform:translateY(220px)}}@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-120px)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes spinReverse{to{transform:rotate(-360deg)}}@keyframes pulseRing{50%{transform:scale(1.03);opacity:.8}}@keyframes clientIn{to{opacity:1;transform:scale(1)}}
@media(max-width:1050px){.nav{gap:15px}.orbit-layout{grid-template-columns:1fr}.service-panel{padding:50px 0 0;text-align:center;margin:auto}.service-panel p{margin-left:auto;margin-right:auto}.orbit-ring{max-width:520px}.clients-wrap{grid-template-columns:1fr}.clients-copy{max-width:600px}.client-stage{width:min(590px,100%)}.work-grid{grid-template-columns:1fr}.work-copy{padding:0 0 25px}.contact-row{grid-template-columns:1fr 1fr}.footer-top{grid-template-columns:1fr 1fr}.footer-top .legacy{display:none}}
@media(max-width:760px){.container{width:calc(100% - 34px)}.header{height:70px}.site-logo img{width:150px;max-height:46px}.nav-toggle{display:flex;flex-direction:column;gap:5px;width:42px;height:42px;justify-content:center;align-items:center}.nav-toggle span{width:23px;height:2px;background:#111}.nav{display:none;position:absolute;left:0;right:0;top:70px;background:#fff;flex-direction:column;align-items:stretch;gap:0;padding:8px 17px 17px;box-shadow:0 18px 35px #0001}.nav.open{display:flex}.nav>a{padding:13px 4px;border-bottom:1px solid #eee}.nav-cta{text-align:center;margin-top:7px}.hero{height:620px}.hero-inner{padding-top:55px}.hero h1{font-size:57px}.hero-kicker{font-size:8px}.hero-inner>p{font-size:12px;max-width:400px}.hero-actions{flex-direction:column;align-items:flex-start}.hero-rail{display:none}.hero-scroll{right:20px}.stats-grid{grid-template-columns:1fr 1fr}.stats-grid>div{min-height:68px;padding:10px;border-bottom:1px solid #ffffff15}.stats-grid>div:nth-child(2){border-right:0}.stats-grid strong{font-size:22px}.stats-grid span{font-size:8px}.section{padding:62px 0}.about-grid{grid-template-columns:1fr}.about-copy h2,.work-copy h2,.impact-copy h2{font-size:47px}.about-scene{height:350px;margin-top:30px}.year-badge{padding:15px}.year-badge strong{font-size:47px}.year-badge span{font-size:14px}.section-head h2{font-size:38px}.orbit-ring{max-width:420px}.orbit-card{width:86px;height:86px}.orbit-card span{font-size:9px}.orbit-center span{font-size:34px}.oc1{margin-left:-43px}.oc4{margin-left:-43px}.oc2{right:-8px}.oc3{right:-7px}.oc5{left:-7px}.oc6{left:-8px}.service-panel h3{font-size:40px}.slide-type{gap:35px}.slide-type span{font-size:25px}.network{height:450px}.network-inner h2{font-size:47px}.clients{padding:70px 0}.clients-copy h2{font-size:49px}.client-grid{inset:22% 10%;gap:8px}.client-card{padding:13px}.showcase-grid{grid-template-columns:1fr;min-height:720px;padding-top:50px;padding-bottom:50px}.showcase-copy{z-index:3}.showcase-visual{height:380px}.big-word{font-size:66px}.word-ring{width:300px;height:300px}.word-ring.small{width:190px;height:190px}.work-grid-cards{height:235px}.work-card.idea{padding:18px}.work-card.idea strong{font-size:30px}.impact-grid{grid-template-columns:1fr}.impact-image{height:270px}.impact-copy{padding:35px 0 0}.cta-inner{min-height:300px;flex-direction:column;align-items:flex-start;justify-content:center}.cta-inner h2{font-size:39px}.footer-top{grid-template-columns:1fr;gap:22px;padding:30px 0}.footer-top nav{justify-content:flex-start;flex-wrap:wrap}.contact-row{grid-template-columns:1fr;gap:16px;padding:18px 0}.footer-bottom>.container{min-height:auto;padding:16px 0;flex-direction:column;align-items:flex-start;gap:11px}.cursor,.cursor-ring{display:none}}
