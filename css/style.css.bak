 .solution-showcase .showcase-text-stage{height:320px!important;margin-bottom:42px}.solution-showcase .showcase-visual{inset:2% 0 8%!important}.solution-showcase .showcase-visual-copy{left:18px!important;bottom:18px!important}.solution-showcase .showcase-visual-copy strong{font-size:38px!important}.solution-showcase .showcase-index{right:12px!important;bottom:10px!important}
 .work-lightbox{padding:12px}.work-lightbox-inner{width:100%;border-radius:10px}.work-lightbox-inner img{max-height:72vh}
}

/* Smooth front-facing flip as each client reaches the center */
.client-carousel.is-flipping .client-card3d.center{animation:clientFlipIn .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes clientFlipIn{0%{opacity:.35;transform:translate(-50%,-50%) translateX(0) translateZ(20px) rotateY(90deg) scale(.82)}100%{opacity:1}}
.client-card3d{backface-visibility:hidden;-webkit-backface-visibility:hidden}


/* ===== LATEST USER FIXES ===== */
/* 360 Advertising Solutions: planet-like continuous orbit; keep center counter above every ring/card. */
.solutions-360 .orbit-layout{align-items:center}
.solutions-360 .orbit-ring{overflow:visible!important;perspective:900px;isolation:isolate}
.solutions-360 .orbit-ring:before{animation:spin 22s linear infinite}
.solutions-360 .orbit-ring:after{animation:spinReverse 14s linear infinite}
.solutions-360 .orbit-center{z-index:50!important;transform:none!important;pointer-events:none}
.solutions-360 .orbit-center span,.solutions-360 .orbit-center small,.solutions-360 .orbit-center b{z-index:55!important;opacity:1!important;visibility:visible!important}
.solutions-360 .orbit-card{z-index:30!important;will-change:transform;transition:background .3s,color .3s,box-shadow .3s!important}
.solutions-360 .orbit-card.active{z-index:35!important}

/* Showcase visual: perfectly centered in the right half, never stuck to the top. */
.solution-showcase .showcase-text-stage{display:flex!important;align-items:center!important;justify-content:center!important;height:560px!important;position:relative!important}
.solution-showcase .showcase-visual{position:absolute!important;top:50%!important;left:50%!important;right:auto!important;bottom:auto!important;width:min(90%,700px)!important;height:min(78%,440px)!important;inset:auto!important;transform:translate(-50%,-50%)!important}
.solution-showcase .showcase-visual img{object-position:center center!important}
.solution-showcase .showcase-visual-copy{left:28px!important;bottom:24px!important}

/* CTA: guarantee BOTH lines of the heading remain visible. */
.cta-inner.reveal{opacity:1!important;transform:none!important;visibility:visible!important}
.cta-inner h2{overflow:visible!important;position:relative!important;z-index:3!important}
.cta-inner h2 em{display:inline!important;visibility:visible!important;opacity:1!important;color:#fff!important}
.cta-inner>div{position:relative;z-index:4}

/* Chatbot temporarily removed from the page, as requested. */
.chatbot,.chat-panel{display:none!important}

