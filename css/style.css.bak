/* Solutions showcase — visual media panel in the open right stage */
.solution-showcase .showcase-text-stage{isolation:isolate}
.solution-showcase .showcase-visual{position:absolute;right:6%;top:50%;width:min(54vw,700px);height:min(390px,32vw);transform:translateY(-50%);overflow:hidden;border:1px solid #ffffff24;background:#111;box-shadow:0 28px 80px #0008;z-index:3;opacity:1}
.solution-showcase .showcase-visual img{width:100%;height:100%;display:block;object-fit:cover;filter:saturate(.92) contrast(1.04);transition:opacity .35s ease,transform .7s cubic-bezier(.16,.7,0,1)}
.solution-showcase .showcase-visual img.is-changing{animation:showcaseImageIn .65s ease both}
.solution-showcase .showcase-visual-shade{position:absolute;inset:0;background:linear-gradient(90deg,#080a0ccc 0%,#080a0c33 55%,#080a0c10 100%),linear-gradient(0deg,#000b,transparent 48%)}
.solution-showcase .showcase-visual-copy{position:absolute;left:38px;bottom:32px;z-index:4;display:flex;flex-direction:column;gap:7px;max-width:70%}
.solution-showcase .showcase-visual-copy small{font-size:10px;font-weight:900;letter-spacing:3px;color:#fff}
.solution-showcase .showcase-visual-copy strong{font:700 clamp(34px,4.2vw,70px)/.88 Oswald,Impact,sans-serif;letter-spacing:-1px;text-shadow:0 5px 22px #0009;transition:color .4s ease}
.solution-showcase .showcase-text-stage .word-ring{z-index:1}
.solution-showcase .showcase-text-stage .word-ring.small{z-index:1}
.solution-showcase .showcase-index{z-index:5}
@keyframes showcaseImageIn{from{opacity:.25;transform:scale(1.06)}to{opacity:1;transform:scale(1)}}
@media(max-width:1050px){.solution-showcase .showcase-visual{right:0;width:55vw;height:36vw}.solution-showcase .showcase-visual-copy{left:25px;bottom:24px}}
@media(max-width:760px){.solution-showcase .showcase-text-stage{min-height:330px}.solution-showcase .showcase-visual{right:16px;left:16px;top:62%;width:auto;height:230px;transform:translateY(-50%)}.solution-showcase .showcase-visual-copy{left:20px;bottom:20px;max-width:85%}.solution-showcase .showcase-visual-copy strong{font-size:34px}.solution-showcase .showcase-text-stage .word-ring{right:-90px!important;top:62%}.solution-showcase .showcase-text-stage .word-ring.small{right:-10px!important;top:62%}.solution-showcase .showcase-index{right:20px;bottom:8px}}

/* ===== FINAL USER FIXES ===== */
.hero-media{background:#08090b;object-position:center center}
.hero-inner h1{font-size:clamp(38px,4.35vw,62px)!important;line-height:.94!important;max-width:620px!important}

/* 360 Solutions: keep the counter above the rotating rings and continuously animate the orbit */
.solutions-360 .orbit-ring{overflow:visible!important;isolation:isolate}
.solutions-360 .orbit-ring:before{animation:spin 18s linear infinite}
.solutions-360 .orbit-ring:after{animation:spinReverse 11s linear infinite}
.solutions-360 .orbit-glow{z-index:0}
.solutions-360 .orbit-center{z-index:10!important;position:absolute!important;overflow:visible!important}
.solutions-360 .orbit-center span,.solutions-360 .orbit-center small,.solutions-360 .orbit-center b{position:relative;z-index:12;display:block}
.solutions-360 .orbit-center b{font:800 9px Inter,sans-serif;letter-spacing:1px;color:#e51b23;margin-top:8px}
.solutions-360 .orbit-card{z-index:8}

/* Solutions showcase: text on left, a clean visual on the right */
.solution-showcase{min-height:620px!important}
.solution-showcase .showcase-grid{grid-template-columns:minmax(300px,42%) minmax(0,58%)!important;min-height:620px!important;align-items:center!important}
.solution-showcase .showcase-copy{position:relative!important;z-index:8!important;padding:50px 20px 50px 0!important}
.solution-showcase .showcase-copy h2{font-size:clamp(44px,4.8vw,64px)!important}
.solution-showcase .showcase-text-stage{position:relative!important;inset:auto!important;height:480px!important;overflow:visible!important;pointer-events:none!important}
.solution-showcase .showcase-visual{position:absolute!important;inset:6% 2% 8% 2%!important;height:auto!important;display:block!important;border-radius:16px!important;overflow:hidden!important;box-shadow:0 30px 80px #0008!important;border:1px solid #ffffff20!important;background:#0d1013!important;z-index:4!important}
.solution-showcase .showcase-visual img{width:100%!important;height:100%!important;object-fit:cover!important;display:block!important;transition:opacity .45s ease,transform .7s ease,filter .45s ease!important;filter:saturate(.98) contrast(1.06) brightness(.72)!important}
.solution-showcase .showcase-visual img.is-changing{animation:showcaseImageIn .65s ease both}
.solution-showcase .showcase-visual-shade{position:absolute!important;inset:0!important;background:linear-gradient(90deg,#000a 0%,#0004 45%,#0001 100%),linear-gradient(0deg,#000a,transparent 55%)!important;z-index:2!important}
.solution-showcase .showcase-visual-copy{position:absolute!important;left:30px!important;bottom:28px!important;z-index:5!important;display:flex!important;flex-direction:column!important;align-items:flex-start!important}
.solution-showcase .showcase-visual-copy small{font:800 10px Inter,sans-serif;letter-spacing:3px;color:#fff;opacity:.9}
.solution-showcase .showcase-visual-copy strong{font:700 clamp(38px,4vw,66px)/.9 Oswald,Impact,sans-serif;letter-spacing:-1px;text-shadow:0 8px 30px #0008}
.solution-showcase .word-ring{z-index:1!important;opacity:.65}
.solution-showcase .showcase-index{z-index:8!important;color:#fff!important;background:#0d1013cc;padding:7px 10px;border:1px solid #ffffff22;border-radius:999px;right:18px!important;bottom:18px!important}
@keyframes showcaseImageIn{from{opacity:.2;transform:scale(1.035)}to{opacity:1;transform:scale(1)}}

/* Work image lightbox */
.work-card{cursor:pointer!important}
.work-lightbox{position:fixed;inset:0;z-index:500;background:#000d;display:flex;align-items:center;justify-content:center;padding:24px;opacity:0;visibility:hidden;transition:.25s}
.work-lightbox.open{opacity:1;visibility:visible}
.work-lightbox-inner{position:relative;width:min(1050px,94vw);max-height:90vh;background:#0b0d10;border:1px solid #ffffff22;border-radius:14px;overflow:hidden;box-shadow:0 40px 120px #000b}
.work-lightbox-inner img{display:block;width:100%;max-height:78vh;object-fit:contain;background:#050607}
#workLightboxCaption{padding:12px 16px;color:#fff;font-size:10px;letter-spacing:1px;text-transform:uppercase}
#workLightboxClose{position:absolute;right:10px;top:10px;z-index:4;width:38px;height:38px;border-radius:50%;border:1px solid #ffffff55;background:#08090bcc;color:#fff;font-size:24px;cursor:pointer}

/* Cute compact chatbot */
.chatbot{right:16px!important;bottom:16px!important;gap:0!important}
.chatbot-orb{width:42px!important;height:42px!important;border-width:1px!important;font-size:16px!important;box-shadow:0 0 0 4px #e51b2320!important}
.chatbot-ping{width:7px!important;height:7px!important}
.chat-panel{right:16px!important;bottom:68px!important;width:min(290px,calc(100% - 32px))!important;border-radius:12px!important}
.chat-head{padding:11px 12px!important}.chat-body{padding:12px!important}.chat-options button{padding:9px 10px!important;font-size:9px!important}

