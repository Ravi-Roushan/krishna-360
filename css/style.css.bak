}

/* ===== SOLUTIONS V2 — premium split layout ===== */
.solution-showcase{position:relative;min-height:720px!important;background:#0f1215!important;color:#fff!important;overflow:hidden!important;padding:96px 0!important}
.solution-showcase .showcase-orbit-bg{position:absolute;inset:-18% -8%;pointer-events:none;opacity:.55}
.solution-showcase .showcase-orbit-bg span{position:absolute;border:1px solid #ffffff0d;border-radius:50%;left:52%;top:50%;transform:translate(-50%,-50%);animation:solutionOrbitSpin 26s linear infinite}
.solution-showcase .showcase-orbit-bg span:nth-child(1){width:720px;height:720px}.solution-showcase .showcase-orbit-bg span:nth-child(2){width:520px;height:520px;border-style:dashed;animation-duration:18s;animation-direction:reverse}.solution-showcase .showcase-orbit-bg span:nth-child(3){width:330px;height:330px;border-color:#e51b2328;animation-duration:12s}
.solution-showcase .showcase-grid.showcase-v2{position:relative;z-index:2;display:grid!important;grid-template-columns:minmax(330px,.78fr) minmax(520px,1.22fr)!important;gap:72px!important;align-items:center!important;min-height:520px!important}
.solution-showcase .showcase-copy{padding:0!important;position:relative!important;z-index:5!important}
.solution-showcase .showcase-kicker{font:800 10px Inter,sans-serif;letter-spacing:3px;color:#777d83;margin:16px 0 7px}
.solution-showcase .showcase-copy h2{font:700 clamp(52px,5.2vw,76px)/.9 Oswald,Impact,sans-serif;letter-spacing:-1.5px;margin:0 0 20px!important}
.solution-showcase .showcase-copy h2 em{display:inline-block;max-width:480px;transition:color .35s ease}
.solution-showcase .showcase-copy>p{max-width:470px;color:#9ba0a5!important;font-size:12px;line-height:1.8;margin:0 0 34px!important}
.solution-showcase .showcase-tabs{display:flex!important;flex-direction:column;gap:9px!important;max-width:390px}
.solution-showcase .showcase-tabs .tab{width:100%;height:56px!important;display:grid!important;grid-template-columns:42px 1fr 24px!important;align-items:center!important;text-align:left!important;padding:0 15px!important;background:#ffffff05!important;color:#9da2a7!important;border:1px solid #ffffff12!important;border-radius:4px!important;cursor:pointer!important;transition:.35s!important}
.solution-showcase .showcase-tabs .tab span{font:700 10px Oswald;color:#666c72}.solution-showcase .showcase-tabs .tab b{font-size:11px;letter-spacing:.2px}.solution-showcase .showcase-tabs .tab i{font-style:normal;opacity:0;transform:translateX(-5px);transition:.3s;text-align:right}
.solution-showcase .showcase-tabs .tab:hover{border-color:#ffffff32!important;background:#ffffff0b!important;transform:translateX(5px)}
.solution-showcase .showcase-tabs .tab.active{background:#e51b23!important;color:#fff!important;border-color:#e51b23!important;box-shadow:0 16px 45px #e51b2326;transform:translateX(12px)}
.solution-showcase .showcase-tabs .tab.active span{color:#fff}.solution-showcase .showcase-tabs .tab.active i{opacity:1;transform:none}
.solution-showcase .showcase-meta{display:flex;align-items:center;gap:16px;margin-top:32px;padding-top:18px;border-top:1px solid #ffffff14;max-width:390px;color:#777d82;font-size:8px;letter-spacing:2px;font-weight:800}.solution-showcase .showcase-meta strong{margin-left:auto;color:#fff;font:700 12px Oswald;letter-spacing:1px}
.solution-showcase .showcase-visual-wrap{position:relative;height:520px;display:flex;align-items:center;justify-content:center;min-width:0}
.solution-showcase .showcase-visual-v2{position:relative;width:min(100%,690px);height:430px;border:1px solid #ffffff1f;border-radius:18px;overflow:hidden;background:#080a0c;box-shadow:0 40px 100px #0009,0 0 70px #e51b2310;transform:perspective(1300px) rotateY(-3deg);transition:transform .6s ease,box-shadow .6s ease}
.solution-showcase .showcase-visual-v2:hover{transform:perspective(1300px) rotateY(0) translateY(-5px);box-shadow:0 45px 110px #000b,0 0 90px #e51b2320}
.solution-showcase .showcase-visual-v2 img{position:absolute;inset:0;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;display:block;filter:brightness(.72) saturate(1.05);transition:opacity .45s ease,transform .8s ease!important}
.solution-showcase .showcase-visual-v2 img.is-changing{animation:showcaseV2ImageIn .7s ease both}
.solution-showcase .showcase-visual-v2:after{content:'';position:absolute;inset:0;border:1px solid #fff1;border-radius:18px;pointer-events:none;z-index:8}
.solution-showcase .visual-topline{position:absolute;z-index:6;left:22px;right:22px;top:19px;display:flex;justify-content:space-between;font-size:8px;font-weight:900;letter-spacing:2px;color:#fff;opacity:.8}.solution-showcase .visual-live{display:flex;align-items:center;gap:7px}.solution-showcase .visual-live i{width:6px;height:6px;border-radius:50%;background:#e51b23;box-shadow:0 0 12px #e51b23;animation:livePulse 1.5s infinite}
.solution-showcase .showcase-visual-v2 .showcase-visual-shade{position:absolute!important;inset:0!important;background:linear-gradient(180deg,#0009 0%,transparent 28%,transparent 45%,#000c 100%),linear-gradient(90deg,#0007,transparent 45%,#0003)!important;z-index:2!important}
.solution-showcase .visual-caption{position:absolute;z-index:7;left:28px;bottom:28px;display:flex;flex-direction:column;align-items:flex-start}.solution-showcase .visual-caption small{font:800 9px Inter;letter-spacing:3px;color:#fff;margin-bottom:8px}.solution-showcase .visual-caption strong{font:700 clamp(34px,4vw,62px)/.9 Oswald;color:#fff;letter-spacing:-1px;text-shadow:0 8px 30px #000b;transition:color .35s ease}
.solution-showcase .visual-corner{position:absolute;z-index:7;right:22px;bottom:22px;text-align:right;font:800 8px/1.4 Inter;letter-spacing:2px;color:#fff8}
.solution-showcase .showcase-orbit-line{position:absolute;width:82%;height:100px;border:1px solid #e51b2330;border-radius:50%;bottom:-2px;left:9%;transform:rotate(-4deg);pointer-events:none;animation:orbitLineMove 7s ease-in-out infinite}
.solution-showcase .showcase-next-card{position:absolute;right:-4px;bottom:24px;z-index:10;background:#15191d;border:1px solid #ffffff1c;border-radius:7px;padding:12px 14px;display:grid;grid-template-columns:auto auto;gap:4px 18px;box-shadow:0 20px 50px #0008}.solution-showcase .showcase-next-card span{grid-column:1/-1;color:#777;font-size:7px;font-weight:900;letter-spacing:2px}.solution-showcase .showcase-next-card b{font:700 13px Oswald}.solution-showcase .showcase-next-card i{font-style:normal;color:#e51b23;font-size:15px}
@keyframes solutionOrbitSpin{to{transform:translate(-50%,-50%) rotate(360deg)}}@keyframes showcaseV2ImageIn{from{opacity:.2;transform:scale(1.06)}to{opacity:1;transform:scale(1)}}@keyframes orbitLineMove{0%,100%{transform:rotate(-4deg) scaleX(.96);opacity:.45}50%{transform:rotate(4deg) scaleX(1.03);opacity:1}}@keyframes livePulse{0%,100%{opacity:1;box-shadow:0 0 0 0 #e51b2355}50%{opacity:.65;box-shadow:0 0 0 7px #e51b2300}}
.solution-showcase.theme-digital .showcase-copy h2 em,.solution-showcase.theme-digital .visual-caption strong{color:#ff2832}.solution-showcase.theme-static .showcase-copy h2 em,.solution-showcase.theme-static .visual-caption strong{color:#fff}.solution-showcase.theme-transit .showcase-copy h2 em,.solution-showcase.theme-transit .visual-caption strong{color:#53bffb}
@media(max-width:1050px){.solution-showcase{padding:76px 0!important}.solution-showcase .showcase-grid.showcase-v2{grid-template-columns:1fr!important;gap:40px!important}.solution-showcase .showcase-copy{max-width:680px}.solution-showcase .showcase-tabs{max-width:100%}.solution-showcase .showcase-visual-wrap{height:500px}.solution-showcase .showcase-visual-v2{width:min(100%,760px);height:430px}.solution-showcase .showcase-orbit-bg span{left:65%;}}
@media(max-width:760px){.solution-showcase{padding:62px 0!important;min-height:auto!important}.solution-showcase .showcase-grid.showcase-v2{gap:30px!important}.solution-showcase .showcase-copy h2{font-size:48px!important}.solution-showcase .showcase-copy>p{font-size:11px}.solution-showcase .showcase-tabs .tab{height:52px!important}.solution-showcase .showcase-tabs .tab.active{transform:none}.solution-showcase .showcase-visual-wrap{height:330px}.solution-showcase .showcase-visual-v2{width:100%;height:285px;border-radius:12px;transform:none}.solution-showcase .visual-caption{left:18px;bottom:18px}.solution-showcase .visual-caption strong{font-size:32px}.solution-showcase .visual-topline{left:16px;right:16px;top:15px;font-size:7px}.solution-showcase .showcase-next-card{display:none}.solution-showcase .showcase-orbit-line{bottom:-4px;height:60px}.solution-showcase .showcase-meta{margin-top:22px}.solution-showcase .showcase-orbit-bg span{left:70%;width:400px!important;height:400px!important}}

/* FINAL POLISH — NAV, SOLUTIONS THEMES & FOOTER */
.nav>a:not(.nav-cta){overflow:hidden;transition:color .25s ease,transform .25s ease;text-shadow:0 0 0 transparent}
.nav>a:not(.nav-cta)::before{content:'';position:absolute;left:-120%;top:50%;width:70%;height:1px;background:linear-gradient(90deg,transparent,var(--red),transparent);transform:translateY(-50%) rotate(-12deg);transition:left .45s ease;opacity:.9}
.nav>a:not(.nav-cta)::after{height:2px!important;box-shadow:0 0 12px #e51b23;transition:width .3s ease!important}
.nav>a:not(.nav-cta):hover{color:var(--red);transform:translateY(-2px);text-shadow:0 0 14px #e51b2340}
.nav>a:not(.nav-cta):hover::before{left:145%}
.nav-cta{position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease!important}
.nav-cta::before{content:'';position:absolute;inset:-20%;background:linear-gradient(110deg,transparent 35%,#ffffff55 50%,transparent 65%);transform:translateX(-120%) skewX(-18deg);transition:transform .55s ease}
.nav-cta:hover{transform:translateY(-3px) scale(1.025)!important;box-shadow:0 0 0 1px #ff3a42,0 12px 35px #e51b2355!important}
.nav-cta:hover::before{transform:translateX(120%) skewX(-18deg)}
.nav-toggle span{transition:transform .3s ease,opacity .3s ease,background .3s ease}.nav-toggle:hover span{background:var(--red);box-shadow:0 0 8px #e51b23}

/* Solution option colors change with the selected format. */
.solution-showcase.theme-digital .showcase-tabs .tab.active{background:linear-gradient(135deg,#ff2933,#bd1018)!important;border-color:#ff2933!important;box-shadow:0 0 0 1px #ff293355,0 15px 45px #e51b2340!important}
.solution-showcase.theme-static .showcase-tabs .tab.active{background:linear-gradient(135deg,#f2f3f4,#b9bdc2)!important;border-color:#fff!important;color:#111!important;box-shadow:0 0 0 1px #ffffff44,0 15px 45px #ffffff1f!important}
.solution-showcase.theme-static .showcase-tabs .tab.active span,.solution-showcase.theme-static .showcase-tabs .tab.active i{color:#111!important}
.solution-showcase.theme-transit .showcase-tabs .tab.active{background:linear-gradient(135deg,#38bdf8,#1674a5)!important;border-color:#53bffb!important;box-shadow:0 0 0 1px #53bffb55,0 15px 45px #1687b840!important}
.solution-showcase.theme-digital .showcase-tabs .tab:hover{background:#e51b231c!important;border-color:#e51b2366!important}
.solution-showcase.theme-static .showcase-tabs .tab:hover{background:#ffffff16!important;border-color:#ffffff44!important}
.solution-showcase.theme-transit .showcase-tabs .tab:hover{background:#53bffb16!important;border-color:#53bffb55!important}
.solution-showcase .showcase-tabs .tab{position:relative;overflow:hidden}
.solution-showcase .showcase-tabs .tab::after{content:'';position:absolute;top:-30%;left:-80%;width:45%;height:160%;background:linear-gradient(90deg,transparent,#ffffff35,transparent);transform:skewX(-20deg);transition:left .55s ease;pointer-events:none}
.solution-showcase .showcase-tabs .tab:hover::after{left:140%}

/* Footer premium cleanup */
.footer{position:relative;overflow:hidden;background:#090b0e!important;color:#fff!important}
.footer::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 78% 20%,#e51b2312,transparent 28%),linear-gradient(120deg,transparent 0 70%,#ffffff03 70% 70.2%,transparent 70.4%);pointer-events:none}
.footer-top,.footer-mid,.footer-bottom{position:relative;z-index:1}
.footer-top{padding-top:58px!important;padding-bottom:42px!important;display:grid!important;grid-template-columns:1.15fr 1.5fr 1fr!important;gap:44px!important;align-items:center!important}
.footer-top .site-logo img{width:205px;filter:brightness(1.08)}
.footer-top nav{display:flex;flex-wrap:wrap;gap:10px 24px!important;align-items:center}
.footer-top nav a{font-size:10px;font-weight:800;letter-spacing:.5px;color:#aeb3b8;position:relative;padding-bottom:6px;transition:color .25s ease,transform .25s ease}
.footer-top nav a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--red);box-shadow:0 0 9px #e51b23;transition:width .28s ease}
.footer-top nav a:hover{color:#fff;transform:translateY(-2px)}.footer-top nav a:hover::after{width:100%}
.footer .legacy{justify-self:end;text-align:right;max-width:230px}.footer .legacy small{display:block;color:#666c72;font-size:8px;line-height:1.5;letter-spacing:.5px;margin-bottom:10px}.footer .legacy img{width:125px;max-height:48px;object-fit:contain;filter:grayscale(1) brightness(1.8);opacity:.72;transition:.3s}.footer .legacy:hover img{filter:grayscale(0) brightness(1);opacity:1}
.footer-mid{border-top:1px solid #ffffff10;border-bottom:1px solid #ffffff10;background:#0d1013cc}
.contact-row{display:grid!important;grid-template-columns:1fr 1fr 1.45fr auto!important;gap:28px!important;align-items:center!important;padding:28px 0!important}
.contact-row>div{min-width:0}.contact-row span{display:block;color:#5f666d;font-size:8px;font-weight:900;letter-spacing:2px;margin-bottom:8px}.contact-row a:not(.footer-campaign),.contact-row p{font-size:11px;line-height:1.55;color:#d8dadd;margin:0;transition:color .25s ease}.contact-row a:not(.footer-campaign):hover{color:var(--red)}
.footer-campaign{display:inline-flex;align-items:center;gap:18px;padding:14px 18px;border:1px solid #e51b2380;color:#fff;font-size:9px;font-weight:900;letter-spacing:1px;white-space:nowrap;transition:.3s ease;position:relative;overflow:hidden}.footer-campaign::before{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent,#e51b2328,transparent);transform:translateX(-120%);transition:.5s}.footer-campaign:hover{background:var(--red);border-color:var(--red);transform:translateY(-3px);box-shadow:0 12px 30px #e51b2338}.footer-campaign:hover::before{transform:translateX(120%)}
.footer-bottom{background:#06080a}.footer-bottom .container{min-height:58px;display:flex;align-items:center;justify-content:space-between;gap:20px;color:#646b71;font-size:8px;letter-spacing:.3px}.footer-bottom strong{color:#bfc4c8}.social-text{display:flex;align-items:center;gap:9px}.social-text b{width:25px;height:25px;border:1px solid #ffffff18;border-radius:50%;display:grid;place-items:center;color:#aeb3b8;font-size:10px;transition:.25s}.social-text b:hover{color:#fff;border-color:var(--red);background:#e51b2318;box-shadow:0 0 14px #e51b2330;transform:translateY(-2px)}
@media(max-width:900px){.footer-top{grid-template-columns:1fr!important;gap:28px!important}.footer .legacy{justify-self:start;text-align:left}.contact-row{grid-template-columns:1fr 1fr!important}.footer-campaign{justify-self:start}.footer-bottom .container{flex-wrap:wrap;padding:16px 0}}
@media(max-width:600px){.footer-top{padding-top:42px!important;padding-bottom:30px!important}.footer-top nav{gap:12px 18px!important}.contact-row{grid-template-columns:1fr!important;gap:20px!important}.footer-bottom .container{flex-direction:column;align-items:flex-start;gap:12px}.nav>a:not(.nav-cta){transform:none}.nav>a:not(.nav-cta):hover{transform:translateX(5px)} }
